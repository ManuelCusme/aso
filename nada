<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Mantenimiento</title>
    <!-- LIBRERÍA JQUERY INCLUIDA VIA CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <h2>FORMULARIO</h2>
    <form id="miForm">
        <label>Campo 1 (ID):</label>
        <input type="text" id="c1"><br><br>

        <label>Campo 2:</label>
        <input type="text" id="c2"><br><br>

        <label>Campo 3:</label>
        <input type="text" id="c3"><br><br>

        <button type="button" onclick="enviar('guardar')">Guardar</button>
        <button type="button" onclick="enviar('editar')">Actualizar</button>
        <button type="button" onclick="limpiar()">Limpiar</button>
    </form>

    <hr>

    <h2>CONSULTA</h2>
    <input type="text" id="txtBuscar" placeholder="Buscar por ID">
    <button type="button" onclick="buscar()">Buscar</button>
    <button type="button" onclick="listar()">Listar Todos</button>

    <br><br>

    <table border="1">
        <thead>
            <tr>
                <th>Campo 1</th>
                <th>Campo 2</th>
                <th>Campo 3</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tblCuerpo"></tbody>
    </table>

    <script>
        const URL = 'MiServlet'; // Asegúrate de que coincida con la URL de tu Servlet

        $(document).ready(function() {
            listar();
        });

        // 1. LISTAR TODOS
        function listar() {
            $.get(URL, { accion: 'listar' }, function(lista) {
                let tbody = $('#tblCuerpo');
                tbody.empty();
                lista.forEach(item => {
                    tbody.append(`
                        <tr>
                            <td>${item.campo1}</td>
                            <td>${item.campo2}</td>
                            <td>${item.campo3}</td>
                            <td>
                                <button type="button" onclick="cargarParaEditar('${item.campo1}', '${item.campo2}', '${item.campo3}')">Editar</button>
                                <button type="button" onclick="eliminar('${item.campo1}')">Eliminar</button>
                            </td>
                        </tr>
                    `);
                });
            }, 'json');
        }

        // 2. BUSCAR UN REGISTRO
        function buscar() {
            let id = $('#txtBuscar').val();
            if(!id) return listar();

            $.get(URL, { accion: 'buscar', id: id }, function(item) {
                let tbody = $('#tblCuerpo');
                tbody.empty();
                if(item) {
                    tbody.append(`
                        <tr>
                            <td>${item.campo1}</td>
                            <td>${item.campo2}</td>
                            <td>${item.campo3}</td>
                            <td>
                                <button type="button" onclick="cargarParaEditar('${item.campo1}', '${item.campo2}', '${item.campo3}')">Editar</button>
                                <button type="button" onclick="eliminar('${item.campo1}')">Eliminar</button>
                            </td>
                        </tr>
                    `);
                } else {
                    alert('No encontrado');
                }
            }, 'json');
        }

        // 3. GUARDAR O EDITAR
        function enviar(accion) {
            $.post(URL, {
                accion: accion,
                campo1: $('#c1').val(),
                campo2: $('#c2').val(),
                campo3: $('#c3').val()
            }, function(res) {
                if(res.status === 'ok') {
                    alert('Operación realizada con éxito');
                    limpiar();
                    listar();
                } else {
                    alert('Error al procesar');
                }
            }, 'json');
        }

        // 4. ELIMINAR
        function eliminar(id) {
            if(confirm('¿Eliminar registro ' + id + '?')) {
                $.post(URL, { accion: 'eliminar', campo1: id }, function(res) {
                    if(res.status === 'ok') {
                        listar();
                    } else {
                        alert('No se pudo eliminar');
                    }
                }, 'json');
            }
        }

        // FUNCIONES AUXILIARES
        function cargarParaEditar(c1, c2, c3) {
            $('#c1').val(c1);
            $('#c2').val(c2);
            $('#c3').val(c3);
        }

        function limpiar() {
            $('#c1').val('');
            $('#c2').val('');
            $('#c3').val('');
            $('#txtBuscar').val('');
        }
    </script>
</body>
</html>
