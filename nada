package Servicios;

import Dao.MiDAO;
import com.google.gson.Gson;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.Collections;

@WebServlet("/MiServlet") // Cambia el nombre de la URL
public class MiServlet extends HttpServlet {
    private final MiDAO dao = new MiDAO();
    private final Gson gson = new Gson();

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws IOException {
        String accion = request.getParameter("accion");
        if (accion == null) accion = "listar";

        Object res = null;
        try {
            switch (accion) {
                case "listar":
                    res = dao.listar();
                    break;
                case "buscar":
                    res = dao.buscar(request.getParameter("id"));
                    break;
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        responder(response, res);
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws IOException {
        request.setCharacterEncoding("UTF-8");
        String accion = request.getParameter("accion");
        boolean ok = false;

        try {
            // Creamos el objeto leyendo los inputs del frontend
            Entidad obj = new Entidad(
                request.getParameter("campo1"),
                request.getParameter("campo2"),
                request.getParameter("campo3")
            );

            switch (accion) {
                case "guardar":
                    ok = dao.insertar(obj);
                    break;
                case "editar":
                    ok = dao.actualizar(obj);
                    break;
                case "eliminar":
                    ok = dao.eliminar(request.getParameter("campo1"));
                    break;
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        responder(response, Collections.singletonMap("status", ok ? "ok" : "error"));
    }

    private void responder(HttpServletResponse response, Object datos) throws IOException {
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        response.getWriter().write(gson.toJson(datos));
    }
}
