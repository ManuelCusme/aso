package Dao;

import Conexion.conexion;
import Servicios.Entidad; // Cambia 'Entidad' por el nombre de tu clase
import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class MiDAO {

    // 1. LISTAR TODOS
    public List<Entidad> listar() throws Exception {
        List<Entidad> lista = new ArrayList<>();
        String sql = "SELECT * FROM tabla"; // Cambia 'tabla'
        try (Connection con = conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) {
                lista.add(new Entidad(
                    rs.getString("campo1"), // Cambia por tus columnas
                    rs.getString("campo2"),
                    rs.getString("campo3")
                ));
            }
        }
        return lista;
    }

    // 2. BUSCAR POR ID / CLAVE
    public Entidad buscar(String id) throws Exception {
        String sql = "SELECT * FROM tabla WHERE campo1 = ?"; // Cambia 'tabla' y 'campo1'
        try (Connection con = conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, id);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return new Entidad(
                        rs.getString("campo1"),
                        rs.getString("campo2"),
                        rs.getString("campo3")
                    );
                }
            }
        }
        return null;
    }

    // 3. INSERTAR / GUARDAR
    public boolean insertar(Entidad obj) throws Exception {
        String sql = "INSERT INTO tabla (campo1, campo2, campo3) VALUES (?, ?, ?)";
        try (Connection con = conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, obj.getCampo1());
            ps.setString(2, obj.getCampo2());
            ps.setString(3, obj.getCampo3());
            return ps.executeUpdate() > 0;
        }
    }

    // 4. ACTUALIZAR / EDITAR
    public boolean actualizar(Entidad obj) throws Exception {
        String sql = "UPDATE tabla SET campo2 = ?, campo3 = ? WHERE campo1 = ?";
        try (Connection con = conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, obj.getCampo2());
            ps.setString(2, obj.getCampo3());
            ps.setString(3, obj.getCampo1()); // La clave va al final por el WHERE
            return ps.executeUpdate() > 0;
        }
    }

    // 5. ELIMINAR
    public boolean eliminar(String id) throws Exception {
        String sql = "DELETE FROM tabla WHERE campo1 = ?";
        try (Connection con = conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, id);
            return ps.executeUpdate() > 0;
        }
    }
}
